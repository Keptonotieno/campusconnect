# =============================================================================
# CAMPUSCONNECT / IG POST HUB ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` or set these in your hosting environment (e.g. Cloudflare / Cloud Run).
# All integrations are ready and only require the respective API keys to start operating.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION HOSTING
# -----------------------------------------------------------------------------
# APP_URL: Base URL where this applet is hosted (used for OAuth redirects and webhooks)
APP_URL="https://keptonotieno.workers.dev"

# GEMINI_API_KEY: Required for AI caption generation and moderation assists.
# Configured in AI Studio Secrets panel.
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 2. META GRAPH API (INSTAGRAM INTEGRATION)
# Obtain these from: https://developers.facebook.com/apps
# -----------------------------------------------------------------------------
# Meta Application ID (from App Settings > Basic)
VITE_META_APP_ID=""

# Meta Application Secret (from App Settings > Basic > App Secret)
# Keep strictly confidential; used on backend or Cloudflare worker
META_APP_SECRET=""

# Long-Lived System User or Page Access Token with permissions:
# instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
VITE_META_ACCESS_TOKEN=""

# Official Instagram Business Account ID (e.g., 17841400000000000)
VITE_INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Secret verification token for incoming Meta Webhooks (App Dashboard > Webhooks)
META_WEBHOOK_VERIFY_TOKEN=""

# -----------------------------------------------------------------------------
# 3. STRIPE PAYMENT GATEWAY
# Obtain these from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Stripe Publishable Key (Safe for client browser, starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Stripe Secret Key (Server-side/Worker only, starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=""

# Stripe Webhook Signing Secret (from Developers > Webhooks endpoint, starts with whsec_)
STRIPE_WEBHOOK_SECRET=""

# Fixed submission fee in cents (e.g. 600 for $6.00 USD)
VITE_FEATURED_POST_PRICE_CENTS="600"

# -----------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (SMTP / RESEND / MAILGUN)
# Used for student submission receipts, review alerts, and admin notifications
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER_EMAIL="notifications@campusconnect.app"
SMTP_SENDER_NAME="CampusConnect Global"

# -----------------------------------------------------------------------------
