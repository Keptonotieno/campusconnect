# =============================================================================
# CAMPUSCONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` or set these secrets in your hosting environment.
# NEVER commit real secrets or private keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION HOSTING & CRYPTOGRAPHIC SECRETS
# -----------------------------------------------------------------------------
# APP_URL: Canonical HTTPS origin where this application is hosted
APP_URL="https://campusconnect.app"

# APP_ENCRYPTION_KEY: 32+ byte random hex/base64 secret used for AES-256-GCM DB field encryption & HMAC
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# SESSION_SECRET: High-entropy secret used for audit chain HMAC and signed file tokens
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# TRUST_PROXY: Set to "true" only when running behind a trusted TLS reverse proxy (Cloudflare / Cloud Run / Nginx)
TRUST_PROXY="false"

# GEMINI_API_KEY: Server-side only (never expose to Vite client bundle)
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 2. STRIPE PAYMENT GATEWAY
# Obtain from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Stripe Publishable Key (safe for browser checkout Elements, starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Stripe Secret Key (server-side ONLY, starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=""

# Stripe Webhook Signing Secret (server-side ONLY, starts with whsec_)
STRIPE_WEBHOOK_SECRET=""

# Fixed submission fee in cents (600 = $6.00 USD)
VITE_FEATURED_POST_PRICE_CENTS="600"

# -----------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (RESEND / SMTP / SIGNED WEBHOOKS)
# -----------------------------------------------------------------------------
# Resend API Key (server-side ONLY, starts with re_)
RESEND_API_KEY=""

# Resend / Svix Webhook Signing Secret (server-side ONLY, starts with whsec_)
RESEND_WEBHOOK_SECRET=""

# Custom SMTP Relay Configuration (server-side ONLY)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER_EMAIL="notifications@campusconnect.app"
SMTP_SENDER_NAME="CampusConnect Global"

# -----------------------------------------------------------------------------
# 4. OPTIONAL INITIAL ADMINISTRATOR SEED (ENV-ONLY)
# Leave empty to complete interactive initial bootstrap + TOTP MFA enrollment in /admin.
# If set, password MUST meet 12+ characters with uppercase, lowercase, digit, and special character.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (PUBLIC WEB SDK IDENTIFIERS ONLY)
# Security is enforced via firestore.rules + server authorization.
# -----------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
